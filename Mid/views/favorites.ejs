<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>我的收藏 - 新聞全視界</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; line-height: 1.6; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; }
    header { background: rgba(0,0,0,0.8); color: #fff; padding: 1rem 2rem; backdrop-filter: blur(10px); position: sticky; top: 0; z-index: 100; box-shadow: 0 2px 20px rgba(0,0,0,0.3); }
    header h1 { display: inline-block; font-size: 1.5rem; letter-spacing: 2px; }
    header h1 a { color: #fff; text-decoration: none; }
    header nav { float: right; display: flex; align-items: center; gap: 0.5rem; }
    header nav a { color: #fff; text-decoration: none; margin-left: 1rem; transition: opacity 0.2s; }
    header nav a:hover { opacity: 0.8; }
    .container { max-width: 900px; margin: 2rem auto; padding: 0 1rem; }
    .post { background: #fff; padding: 1.5rem; margin-bottom: 1rem; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); position: relative; transition: transform 0.2s, box-shadow 0.2s; }
    .post:hover { transform: translateY(-2px); box-shadow: 0 6px 25px rgba(0,0,0,0.15); }
    .post.news { border-left: 5px solid #28a745; }
    .post h2 { font-size: 1.2rem; line-height: 1.4; }
    .post h2 a { color: #333; text-decoration: none; }
    .post h2 a:hover { color: #007bff; }
    .post .meta { color: #888; font-size: 0.85rem; margin-bottom: 0.5rem; }
    .post .content { color: #555; font-size: 0.95rem; line-height: 1.7; }
    .post .actions { display: flex; gap: 0.5rem; align-items: center; margin-top: 1rem; flex-wrap: wrap; }
    .badge { display: inline-block; padding: 0.25rem 0.6rem; color: #fff; font-size: 0.7rem; border-radius: 20px; margin-right: 0.5rem; font-weight: bold; }
    .badge-BBC { background: #bb1919; }
    .badge-CNN { background: #cc0000; }
    .badge-Reuters { background: #ff8000; }
    .badge-NPR { background: #2986bc; }
    .badge-ABC { background: #000; }
    .btn { display: inline-block; padding: 0.4rem 0.8rem; background: #007bff; color: #fff; text-decoration: none; border-radius: 6px; border: none; cursor: pointer; font-size: 0.85rem; transition: all 0.2s; }
    .btn:hover { background: #0056b3; transform: translateY(-1px); box-shadow: 0 2px 8px rgba(0,123,255,0.3); }
    .btn-like { background: #28a745; }
    .btn-like:hover { background: #218838; box-shadow: 0 2px 8px rgba(40,167,69,0.3); }
    .btn-favorite { background: #e91e63; }
    .btn-favorite:hover { background: #c2185b; box-shadow: 0 2px 8px rgba(233,30,99,0.3); }
    .like-count { color: #28a745; font-weight: bold; font-size: 0.85rem; }
  </style>
</head>
<body>
  <header>
    <h1><a href="/">📰 新聞全視界</a></h1>
    <nav>
      <a href="/">🏠 首頁</a>
      <a href="/logout">🚪 登出</a>
    </nav>
  </header>
  <div class="container">
    <h2 style="margin-bottom:1.5rem; color:#fff; font-size:1.5rem;">⭐ 我的收藏</h2>
    <% if (posts.length === 0) { %>
      <p>還沒有收藏任何文章。</p>
    <% } else { %>
      <% posts.forEach(post => { %>
        <div class="post <%= post.is_news ? 'news' : '' %>">
          <h2>
            <% if (post.is_news) { %>
              <span class="badge badge-<%= post.news_source ? String(post.news_source).replace(/\s+/g, '') : 'BBC' %>"><%= post.news_source || '新聞' %></span>
            <% } %>
            <a href="/post/<%= post.id %>"><%= post.title %></a>
          </h2>
          <div class="meta">
            <% if (post.username) { %>作者: <%= post.username %> | <% } %>
            <%= new Date(post.created_at).toLocaleString('zh-TW') %>
          </div>
          <div class="content"><%= post.content.substring(0, 200) %><%= post.content.length > 200 ? '...' : '' %></div>
          <div class="actions">
            <form action="/like/<%= post.id %>" method="POST" style="display:inline;">
              <button type="submit" class="btn <%= likedPosts.includes(post.id) ? 'btn-like' : 'btn-like' %>">
                <%= likedPosts.includes(post.id) ? '收回' : '按讚' %>
              </button>
            </form>
            <form action="/favorite/<%= post.id %>" method="POST" style="display:inline;">
              <button type="submit" class="btn btn-favorite">取消收藏</button>
            </form>
            <span class="like-count">讚: <%= post.like_count || 0 %></span>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>
</body>
</html>