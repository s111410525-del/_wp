<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= post.title %></title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; line-height: 1.6; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; }
    header { background: rgba(0,0,0,0.8); color: #fff; padding: 1rem 2rem; backdrop-filter: blur(10px); position: sticky; top: 0; z-index: 100; box-shadow: 0 2px 20px rgba(0,0,0,0.3); }
    header h1 { display: inline-block; font-size: 1.5rem; letter-spacing: 2px; }
    header h1 a { color: #fff; text-decoration: none; }
    header nav { float: right; display: flex; align-items: center; gap: 0.5rem; }
    header nav a { color: #fff; text-decoration: none; margin-left: 1rem; transition: opacity 0.2s; }
    header nav a:hover { opacity: 0.8; }
    .container { max-width: 900px; margin: 2rem auto; padding: 0 1rem; }
    .post { background: #fff; padding: 2rem; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); margin-bottom: 2rem; position: relative; }
    .post.news { border-left: 5px solid #28a745; }
    .post-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 1rem; }
    .post h1 { margin-bottom: 0.5rem; font-size: 1.5rem; line-height: 1.4; }
    .post h1 a { color: #333; text-decoration: none; }
    .post h1 a:hover { color: #007bff; }
    .badge { display: inline-block; padding: 0.25rem 0.6rem; color: #fff; font-size: 0.75rem; border-radius: 20px; margin-right: 0.5rem; font-weight: bold; }
    .badge-BBC { background: #bb1919; }
    .badge-CNN { background: #cc0000; }
    .badge-Reuters { background: #ff8000; }
    .badge-NPR { background: #2986bc; }
    .badge-ABC { background: #000; }
    .badge-BBC中文 { background: #bb1919; }
    .badge-香港電台 { background: #00843d; }
    .meta { color: #888; font-size: 0.9rem; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
    .meta .link-label { color: #28a745; font-weight: bold; }
    .meta .news-link { color: #007bff; word-break: break-all; text-decoration: none; }
    .meta .news-link:hover { color: #0056b3; text-decoration: underline; }
    .content { white-space: pre-wrap; margin-bottom: 1.5rem; color: #444; line-height: 1.8; }
    .actions { display: flex; gap: 0.5rem; align-items: center; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid #eee; flex-wrap: wrap; }
    a { color: #007bff; }
    .btn { display: inline-block; padding: 0.4rem 0.8rem; background: #007bff; color: #fff; text-decoration: none; border-radius: 6px; border: none; cursor: pointer; font-size: 0.85rem; transition: all 0.2s; }
    .btn:hover { background: #0056b3; transform: translateY(-1px); box-shadow: 0 2px 8px rgba(0,123,255,0.3); }
    .btn-like { background: #28a745; }
    .btn-like:hover { background: #218838; box-shadow: 0 2px 8px rgba(40,167,69,0.3); }
    .btn-report { background: #ffc107; color: #333; }
    .btn-report:hover { background: #e0a800; color: #333; box-shadow: 0 2px 8px rgba(255,193,7,0.3); }
    .btn-danger { background: #dc3545; }
    .btn-danger:hover { background: #c82333; box-shadow: 0 2px 8px rgba(220,53,69,0.3); }
    .btn-external { background: #6c757d; }
    .btn-external:hover { background: #545b62; box-shadow: 0 2px 8px rgba(108,117,125,0.3); }
    .btn-favorite { background: #e91e63; }
    .btn-favorite:hover { background: #c2185b; box-shadow: 0 2px 8px rgba(233,30,99,0.3); }
    .like-count { color: #28a745; font-weight: bold; font-size: 0.85rem; }
    .btn-translate { background: #17a2b8; }
    .btn-translate:hover { background: #138496; box-shadow: 0 2px 8px rgba(23,162,184,0.3); }
    .comments { background: #fff; padding: 2rem; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); margin-bottom: 2rem; }
    .comments h3 { margin-bottom: 1rem; color: #333; }
    .comment { padding: 1rem; background: #f8f9fa; border-radius: 8px; margin-bottom: 1rem; border-left: 3px solid #007bff; }
    .comment .comment-header { display: flex; justify-content: space-between; color: #888; font-size: 0.85rem; margin-bottom: 0.5rem; }
    .comment .comment-content { color: #333; }
    .comment-form { margin-top: 1.5rem; }
    .comment-form textarea { width: 100%; padding: 0.75rem; border: 1px solid #ddd; border-radius: 8px; min-height: 80px; font-family: inherit; resize: vertical; transition: border-color 0.2s; }
    .comment-form textarea:focus { border-color: #007bff; outline: none; box-shadow: 0 0 0 3px rgba(0,123,255,0.1); }
    .comment-form .btn { margin-top: 0.5rem; }
    .no-comments { color: #888; font-style: italic; }
    .translate-info { background: #e7f3ff; padding: 0.75rem 1rem; border-radius: 8px; margin-bottom: 1rem; font-size: 0.9rem; color: #0066cc; border: 1px solid #b3d7ff; }
  </style>
</head>
<body>
  <header>
    <h1><a href="/">📰 新聞全視界</a></h1>
    <nav>
      <a href="/">🏠 首頁</a>
      <% if (user) { %>
        <a href="/favorites">⭐ 收藏</a>
        <a href="/logout">🚪 登出</a>
      <% } else { %>
        <a href="/login">🔑 登入</a>
      <% } %>
    </nav>
  </header>
  <div class="container">
      <div class="post <%= post.is_news ? 'news' : '' %>">
      <div class="post-header">
        <h1>
          <% if (post.is_news) { %><span class="badge badge-<%= post.news_source ? String(post.news_source).replace(/\s+/g, '') : 'BBC' %>"><%= post.news_source || '新聞' %></span><% } %>
          <%= post.title %>
          <% if (post.is_news && post.news_link) { %>
            <a href="<%= post.news_link %>" target="_blank" rel="noopener" style="font-size:0.85rem; color:#28a745; text-decoration:none; margin-left:0.5rem;"><%= post.news_link %></a>
          <% } %>
        </h1>
        <% if (user) { %>
          <form action="/report/<%= post.id %>" method="POST" style="display:inline;">
            <button type="submit" class="btn btn-report" onclick="return confirm('確定要檢舉嗎?')">檢舉</button>
          </form>
        <% } %>
      </div>
      <div class="meta">
        <% if (post.news_link) { %>
          <span class="link-label">文章連結</span>
          <a href="<%= post.news_link %>" target="_blank" class="news-link"><%= post.news_link %></a>
          <span style="color:#ccc;">|</span>
        <% } %>
        <% if (post.username) { %>作者: <%= post.username %> | <% } %>
        <%= new Date(post.created_at).toLocaleString('zh-TW') %>
      </div>
      <div class="content"><%= post.content %></div>
      <% if (isTranslated) { %>
        <div class="translate-info">
          以上為翻譯內容 | <a href="/post/<%= post.id %>">查看原文</a>
        </div>
      <% } %>
      <div class="actions">
        <% if (isTranslated) { %>
        <a href="/post/<%= post.id %>" class="btn btn-translate">查看原文</a>
      <% } else { %>
        <a href="/post/<%= post.id %>?lang=zh" class="btn btn-translate">翻譯成中文</a>
      <% } %>
        <% if (user) { %>
          <form action="/like/<%= post.id %>" method="POST" style="display:inline;">
            <button type="submit" class="btn btn-like"><%= isLiked ? '收回' : '按讚' %></button>
          </form>
          <form action="/favorite/<%= post.id %>" method="POST" style="display:inline;">
            <button type="submit" class="btn btn-favorite"><%= isFavorited ? '取消收藏' : '收藏' %></button>
          </form>
        <% } %>
        <span class="like-count">讚: <%= likeCount %></span>
        <button class="btn" onclick="copyLink()">分享</button>
        <% if (post.is_news && post.news_link) { %>
          <a href="<%= post.news_link %>" target="_blank" class="btn btn-external">閱讀原文</a>
        <% } %>
        <% if (user && post.user_id === user.id) { %>
          <form action="/delete/<%= post.id %>" method="POST" style="display:inline; margin-left:auto;">
            <button type="submit" class="btn btn-danger" onclick="return confirm('確定要刪除嗎?')">刪除</button>
          </form>
        <% } %>
      </div>
    </div>

    <div class="comments">
      <h3>留言 (<%= comments.length %>)</h3>
      <% if (comments.length === 0) { %>
        <p class="no-comments">還沒有留言</p>
      <% } else { %>
        <% comments.forEach(comment => { %>
          <div class="comment">
            <div class="comment-header">
              <span><%= comment.username %> 說:</span>
              <span><%= new Date(comment.created_at).toLocaleString('zh-TW') %></span>
            </div>
            <div class="comment-content"><%= comment.content %></div>
          </div>
        <% }) %>
      <% } %>
      
      <% if (user) { %>
        <form class="comment-form" action="/comment/<%= post.id %>" method="POST">
          <textarea name="content" placeholder="寫下你的留言..." required></textarea>
          <button type="submit" class="btn">發布留言</button>
        </form>
      <% } else { %>
        <p><a href="/login">登入</a> 後才能留言</p>
      <% } %>
    </div>
  </div>
  <script>
    function copyLink() {
      const url = window.location.href;
      navigator.clipboard.writeText(url).then(() => {
        alert('連結已複製: ' + url);
      }).catch(() => {
        prompt('複製以下連結:', url);
      });
    }
  </script>
</body>
</html>